{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Macro Studio",
  "version": "0.0.5",
  "identifier": "dev.macrostudio.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Macro Studio",
        "width": 1320,
        "height": 820,
        "minWidth": 980,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERBOENFNEY1MzBFMUQ0NzAKUldSdzFPRXc5ZVNNMm5TOFVYMmt1SDZoWWtwTklkdGZYbWp4RTVEaDJLY2tTK1BGVkJQT041a2gK",
      "endpoints": [
        "https://github.com/HighPolyNeko/MacroStudio/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
